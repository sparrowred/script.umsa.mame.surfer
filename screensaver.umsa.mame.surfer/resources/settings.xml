<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="screensaver.umsa.mame.surfer">
    <category id="general" label="32000">
      <group id="core_settings">
        <setting id="open_core_settings" type="action" label="30199">
          <data>Addon.OpenSettings(script.module.umsa.core)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
      </group>
      <group id="configuration" label="32010">
        <setting id="ssaver_time" type="integer" label="30010">
          <default>10</default>
          <constraints>
            <minimum>2</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ssaver_info" type="boolean" label="30056">
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="modes" label="30067">
        <setting id="ssaver_videos" type="boolean" label="30058">
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="ssaver_slide" type="boolean" label="30065">
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="ssaver_wall" type="boolean" label="30059">
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="ssaver_cross" type="boolean" label="30068">
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="wall" label="30062">
        <setting id="ssaver_trows" type="integer" label="30054">
          <default>5</default>
          <constraints>
            <minimum>3</minimum>
            <step>1</step>
            <maximum>9</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ssaver_trows_b" type="integer" label="30055">
          <default>7</default>
          <constraints>
            <minimum>3</minimum>
            <step>1</step>
            <maximum>9</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ssaver_srows" type="integer" label="30066">
          <default>3</default>
          <constraints>
            <minimum>3</minimum>
            <step>1</step>
            <maximum>9</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ssaver_srows_b" type="integer" label="30055">
          <default>5</default>
          <constraints>
            <minimum>3</minimum>
            <step>1</step>
            <maximum>9</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ssaver_free" type="integer" label="30064">
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>10</step>
            <maximum>50</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="ssaver_titles" type="string" label="30063">
          <default>Random</default>
          <constraints>
            <options>
              <option>Both</option>
              <option>Snaps</option>
              <option>Titles</option>
              <option>Random</option>
            </options>
            <allowempty>true</allowempty>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
