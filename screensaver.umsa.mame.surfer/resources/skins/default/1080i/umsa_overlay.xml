<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi 1080i layout: 1920x1080 coordinates, same resolution as umsa_saver.xml.
     Foreground above umsa_saver.xml: game info, left artwork and one music line.
     No full-screen background, the overlay stays transparent. The texts are
     buttons with an automatic width: only a button stretches its texture to
     the length of its text, which gives every line a translucent dark plate
     (Python cannot measure a text). Focus and no-focus look the same and
     there is no onclick, the buttons only display. -->
<window>
    <!-- above umsa_saver.xml (zorder 1) -->
    <zorder>2</zorder>
    <controls>
        <control type="group">
            <description>game info, switched off by ssaver_info. LabelView.Fade: 0 = fade in, 1 = fade out, empty = hidden at once (new content)</description>
            <visible>!String.IsEqual(Window.Property(GameInfo.Hidden),true) + String.IsEqual(Window.Property(LabelView.Fade),0)</visible>
            <animation type="Visible">
                <effect type="fade" start="0" end="100" time="1000"/>
            </animation>
            <animation type="Hidden" condition="String.IsEqual(Window.Property(LabelView.Fade),1)">
                <effect type="fade" start="100" end="0" time="1000"/>
            </animation>
            <control type="image" id="104">
                <description>left artwork; Python sizes it to the aspect ratio of the artwork (left_art.py)</description>
                <posx>15</posx>
                <posy>855</posy>
                <width>280</width>
                <height>210</height>
                <fadetime>200</fadetime>
                <aspectratio>stretch</aspectratio>
            </control>
            <control type="image" id="105">
                <description>machine</description>
                <posx>1785</posx>
                <posy>975</posy>
                <width>120</width>
                <height>90</height>
                <texture></texture>
                <aspectratio scalediffuse="true" alignx="right" aligny="center">keep</aspectratio>
            </control>
            <control type="grouplist">
                <description>right-aligned row: the plate of 102 ends at x 1770</description>
                <posx>570</posx>
                <posy>975</posy>
                <width>1200</width>
                <height>39</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <itemgap>0</itemgap>
                <control type="button" id="102">
                    <description>name and year</description>
                    <width min="1" max="1200">auto</width>
                    <height>39</height>
                    <visible>!String.IsEmpty(Control.GetLabel(102))</visible>
                    <textoffsetx>12</textoffsetx>
                    <aligny>center</aligny>
                    <font>font14</font>
                    <textcolor>white</textcolor>
                    <focusedcolor>white</focusedcolor>
                    <shadowcolor>black</shadowcolor>
                    <texturenofocus colordiffuse="99000000">screensaver-black.png</texturenofocus>
                    <texturefocus colordiffuse="99000000">screensaver-black.png</texturefocus>
                </control>
            </control>
            <control type="grouplist">
                <description>right-aligned row: the plate of 108 ends at x 1770</description>
                <posx>570</posx>
                <posy>1014</posy>
                <width>1200</width>
                <height>39</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <itemgap>0</itemgap>
                <control type="button" id="108">
                    <description>maker (category)</description>
                    <width min="1" max="1200">auto</width>
                    <height>39</height>
                    <visible>!String.IsEmpty(Control.GetLabel(108))</visible>
                    <textoffsetx>12</textoffsetx>
                    <aligny>center</aligny>
                    <font>font13</font>
                    <textcolor>white</textcolor>
                    <focusedcolor>white</focusedcolor>
                    <shadowcolor>black</shadowcolor>
                    <texturenofocus colordiffuse="99000000">screensaver-black.png</texturenofocus>
                    <texturefocus colordiffuse="99000000">screensaver-black.png</texturefocus>
                </control>
            </control>
        </control>
        <control type="group">
            <description>music info: one line, VGM info first, otherwise Kodi music (Core setting show_music_info)</description>
            <control type="button" id="4100">
                <description>VGM info, text and format from UMSA.VGM.Info unchanged</description>
                <posx>60</posx>
                <posy>15</posy>
                <visible>!String.IsEqual(Window(10000).Property(UMSA.VGM.Info),)</visible>
                <label>$INFO[Window(10000).Property(UMSA.VGM.Info)]</label>
                <width min="1" max="1500">auto</width>
                <height>33</height>
                <textoffsetx>12</textoffsetx>
                <aligny>center</aligny>
                <font>font10</font>
                <textcolor>FFB2D4F5</textcolor>
                <focusedcolor>FFB2D4F5</focusedcolor>
                <shadowcolor>ff000000</shadowcolor>
                <texturenofocus colordiffuse="99000000">screensaver-black.png</texturenofocus>
                <texturefocus colordiffuse="99000000">screensaver-black.png</texturefocus>
            </control>
            <control type="button" id="4101">
                <description>Kodi music: Song – Artist (-mm:ss remaining); empty parts drop their separator</description>
                <posx>60</posx>
                <posy>15</posy>
                <visible>String.IsEqual(Window(10000).Property(UMSA.VGM.Info),) + Player.HasAudio + !String.IsEqual(Window.Property(MusicInfo.Hidden),true) + !String.IsEmpty(MusicPlayer.Title)</visible>
                <label>$INFO[MusicPlayer.Title]$INFO[MusicPlayer.Artist, – ]$INFO[Player.TimeRemaining(mm:ss), (-,)]</label>
                <width min="1" max="1500">auto</width>
                <height>33</height>
                <textoffsetx>12</textoffsetx>
                <aligny>center</aligny>
                <font>font10</font>
                <textcolor>FFB2D4F5</textcolor>
                <focusedcolor>FFB2D4F5</focusedcolor>
                <shadowcolor>ff000000</shadowcolor>
                <texturenofocus colordiffuse="99000000">screensaver-black.png</texturenofocus>
                <texturefocus colordiffuse="99000000">screensaver-black.png</texturefocus>
            </control>
            <control type="button" id="4102">
                <description>Kodi music without title: Artist (-mm:ss remaining)</description>
                <posx>60</posx>
                <posy>15</posy>
                <visible>String.IsEqual(Window(10000).Property(UMSA.VGM.Info),) + Player.HasAudio + !String.IsEqual(Window.Property(MusicInfo.Hidden),true) + String.IsEmpty(MusicPlayer.Title)</visible>
                <label>$INFO[MusicPlayer.Artist,, ]$INFO[Player.TimeRemaining(mm:ss),(-,)]</label>
                <width min="1" max="1500">auto</width>
                <height>33</height>
                <textoffsetx>12</textoffsetx>
                <aligny>center</aligny>
                <font>font10</font>
                <textcolor>FFB2D4F5</textcolor>
                <focusedcolor>FFB2D4F5</focusedcolor>
                <shadowcolor>ff000000</shadowcolor>
                <texturenofocus colordiffuse="99000000">screensaver-black.png</texturenofocus>
                <texturefocus colordiffuse="99000000">screensaver-black.png</texturefocus>
            </control>
        </control>
    </controls>
</window>
