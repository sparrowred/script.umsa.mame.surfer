msgctxt "#30200"
msgid "The MAME program (mame or mame.exe). Required to start games."
msgstr ""

msgctxt "#30201"
msgid "Leave empty to search automatically: next to the MAME executable, then ~/.mame/mame.ini (Linux/macOS)."
msgstr ""

msgctxt "#30202"
msgid "Folder MAME is started in; relative paths in mame.ini are resolved from here. Leave empty to use the folder of the found mame.ini, otherwise the folder of the MAME executable."
msgstr ""

msgctxt "#30203"
msgid "Used to extract CHD images. Leave empty to use chdman next to the MAME executable."
msgstr ""

msgctxt "#30204"
msgid "Normal: start the emulator directly. Watch: capture the emulator output and show it after exit. Fallback: start the emulator inside the terminal below."
msgstr ""

msgctxt "#30205"
msgid "Terminal program used by the Fallback start mode, for example xterm. It is called with -e and the emulator command."
msgstr ""

msgctxt "#30206"
msgid "Root folder of your eXoDOS collection. Leave empty if you do not have it."
msgstr ""

msgctxt "#30207"
msgid "Root folder of your GameBase64 collection. Leave empty if you do not have it."
msgstr ""

msgctxt "#30208"
msgid "Root folder of your WHDLoad collection. Leave empty if you do not have it."
msgstr ""

msgctxt "#30210"
msgid "Opens the settings of the UMSA screensaver add-on (modes, timing, wall layout)."
msgstr ""

msgctxt "#30211"
msgid "Folder with the Progetto-SNAPS artwork (snaps, titles, cabinets, videos, manuals, ...)."
msgstr ""

msgctxt "#30212"
msgid "Additional artwork in the same folder structure as Progetto-SNAPS."
msgstr ""

msgctxt "#30213"
msgid "Folder with history.xml, mameinfo.dat and other support files shown in the info panel."
msgstr ""

msgctxt "#30214"
msgid "A separate MAME build for Video Game Music playback. Leave empty to use the MAME executable."
msgstr ""

msgctxt "#30215"
msgid "Local TCP port used to control the VGM playback. Change it only if port 1234 is used by another program."
msgstr ""

msgctxt "#30216"
msgid "Show title and system of the playing music (UMSA VGM and Kodi music) in the frontend and the screensaver."
msgstr ""

msgctxt "#30217"
msgid "Show VGM softwarelist entries in the selected software's machine list."
msgstr ""

msgctxt "#30218"
msgid "Maximum VGM playback duration, from 20 to 300 seconds. Defaults to 180 seconds."
msgstr ""

msgctxt "#30219"
msgid "Duration of the selected software's intro VGM, from 0 to 30 seconds. Set to 0 to disable intro playback."
msgstr ""

msgctxt "#30220"
msgid "Region whose version is shown first when a software exists in several regions."
msgstr ""

msgctxt "#30221"
msgid "Play the video of the selected software automatically."
msgstr ""

msgctxt "#30222"
msgid "Folder for extracted ROMs and CHDs and for the ROM cache. Leave empty to use the Kodi temp folder."
msgstr ""

msgctxt "#30223"
msgid "Sort extracted and cached ROMs into Batocera-style system folders inside the ROM temp folder. Off: one folder per set."
msgstr ""

msgctxt "#30224"
msgid "Program used to open manuals when the Kodi PDF reader add-on is not installed."
msgstr ""

msgctxt "#30225"
msgid "Aspect ratio of your screen, used to place the artwork correctly."
msgstr ""

msgctxt "#30226"
msgid "Copy the ROMs and CHDs of every started game into the ROM temp folder and start from there (other emulators and Kodi RetroPlayer, not MAME). Off: only archives an emulator cannot read are extracted there."
msgstr ""

msgctxt "#30230"
msgid "Remove outdated entries from the status database. Not implemented yet."
msgstr ""

msgctxt "#30231"
msgid "Delete umsa.db. It is downloaded again on the next start. A running UMSA frontend is closed first."
msgstr ""

msgctxt "#30232"
msgid "Delete status.db with history, filters and emulator assignments. A running UMSA frontend is closed first."
msgstr ""

msgctxt "#30233"
msgid "Delete artwork.db and dat.db. Scan artwork and support files again afterwards. A running UMSA frontend is closed first."
msgstr ""

